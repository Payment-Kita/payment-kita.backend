# Server
SERVER_PORT=8080
SERVER_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=paymentkita
DB_SSLMODE=disable

# Redis
REDIS_URL=redis://localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Shared internal secret between frontend proxy and backend
INTERNAL_PROXY_SECRET=change-me-in-production

# Blockchain RPC
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BSC_SEPOLIA_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# EVM owner key for on-chain admin operations (register adapter / set default bridge type)
EVM_OWNER_PRIVATE_KEY=

# CCIP
CCIP_ROUTER_ADDRESS=0x...

# Logging
LOG_LEVEL=debug

# Partner hosted payment page base URL.
# Recommended: point to frontend base URL (without trailing slash).
# Backend will generate payment_url as <base>/pay/:id.
# Resolution order:
# PARTNER_CHECKOUT_BASE_URL -> FRONTEND_BASE_URL -> NEXT_PUBLIC_APP_URL/NEXT_PUBLIC_FRONTEND_URL/NEXT_PUBLIC_SITE_URL -> fallback https://payment-kita.excitech.id/
PARTNER_CHECKOUT_BASE_URL=
FRONTEND_BASE_URL=

# Optional simulator-backed quote fallback for partner/create-payment quoting.
# When configured, backend will call this endpoint if accurate quote fails and swapper returns placeholder 1:1.
PAYMENT_SIMULATOR_QUOTE_URL=
PAYMENT_SIMULATOR_QUOTE_API_KEY=
PAYMENT_SIMULATOR_TIMEOUT_MS=8000
